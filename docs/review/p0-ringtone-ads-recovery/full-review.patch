+                onView(withText(R.string.ringtone_source_file)).perform(click())
+                await { device.currentPackageName != app.packageName }
+                if (device.findObject(By.textContains(title)) == null) {
+                    UiScrollable(UiSelector().scrollable(true)).scrollIntoView(UiSelector().textContains(title))
+                }

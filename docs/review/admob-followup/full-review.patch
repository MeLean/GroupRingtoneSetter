+
+    @Test
+    fun `fourth impression dismissal completes once without another preload`() = withHelper { helper ->
+        repeat(3) { app.ads.interstitialAdPolicy.onAdImpression(SystemClock.elapsedRealtime() - 90_000) }
+        val ad = TestInterstitial()

+                assertNotNull(app.fakeDefaultTones.appliedTones.single().second)
+                assertEquals(1, app.fakeInterstitial.showCalls)
+                if (destroy) assertTrue(host[0]?.get()?.isDestroyed != false)
+                onView(withText(R.string.ok)).perform(click())

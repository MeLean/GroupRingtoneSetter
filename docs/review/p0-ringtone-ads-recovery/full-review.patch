+        val rows = device.findObjects(By.res("android", "text1"))
+        // Skip default/silent rows; require a real installed tone rather than masking absence.
+        assertTrue("System picker needs at least three selectable rows", rows.size > 2)
+        rows[2].click()
+        requireNotNull(device.findObject(By.res("android", "button1"))).click()
+    }
+
+    private fun awaitApp() = await { device.currentPackageName == app.packageName }
+    private fun await(condition: () -> Boolean) {
+        val deadline = SystemClock.uptimeMillis() + 10_000L
+        while (SystemClock.uptimeMillis() < deadline) {
+            if (condition()) return
+            SystemClock.sleep(50)
+        }
+        throw AssertionError("External picker/lifecycle condition timed out")
+    }
+
+    private fun shell(command: String): String = ParcelFileDescriptor.AutoCloseInputStream(
+        instrumentation.uiAutomation.executeShellCommand(command)
+    ).use { it.readBytes().toString(Charsets.UTF_8).trim() }
+
+    private fun withActivityModes(block: (Boolean) -> Unit) {
+        // Do not change developer settings on a personal connected phone.
+        assertTrue("Use a disposable emulator for the developer-option matrix", Build.MODEL.contains("sdk", true) || Build.FINGERPRINT.contains("generic"))
+        val previous = shell("settings get global always_finish_activities")
+        assertTrue(previous in listOf("null", "0", "1"))
+        try {
+            listOf(false, true).forEach { destroy ->
+                shell("settings put global always_finish_activities ${if (destroy) 1 else 0}")
+                assertEquals(if (destroy) "1" else "0", shell("settings get global always_finish_activities"))
+                block(destroy)
+            }
+        } finally {
+            if (previous == "null") shell("settings delete global always_finish_activities")
+            else shell("settings put global always_finish_activities $previous")
+        }
+    }

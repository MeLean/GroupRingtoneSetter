<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls"
    android:scrollbars="vertical">

    <LinearLayout
        android:id="@+id/llDialogContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <com.milen.grounpringtonesetter.customviews.ui.texts.CustomTextView
            android:id="@+id/ctvThemeLabel"
            style="@style/TextAppearance.MaterialComponents.Subtitle1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/group_theme" />

        <RadioGroup
            android:id="@+id/rgThemeOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/rbThemeClassic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/group_theme_classic" />

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/rbThemeDarkHighContrast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/group_theme_dark_high_contrast" />

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/rbThemeLightHighContrast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/group_theme_light_high_contrast" />
        </RadioGroup>

        <com.milen.grounpringtonesetter.customviews.ui.texts.CustomTextView
            android:id="@+id/ctvSortLabel"
            style="@style/TextAppearance.MaterialComponents.Subtitle1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/group_sorting" />

        <RadioGroup
            android:id="@+id/rgSortOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/rbSortCurrentOrder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/group_sorting_current_order" />

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/rbSortAscending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/group_sorting_ascending" />

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/rbSortDescending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/group_sorting_descending" />
        </RadioGroup>

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/cbShowReadOnlyGroups"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/show_read_only_groups" />
    </LinearLayout>
</ScrollView>
